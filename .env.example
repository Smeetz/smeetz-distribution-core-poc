# smeetz-distribution-core (discovery spike, CHAT-190)
# Copy to .env — values below are the dev defaults the code falls back to anyway.

# Server
PORT=8000

# Tiqets adapter — shared secret Tiqets sends in the API-Key header.
# Dev default matches the official tester examples (-k 'secret').
TIQETS_API_KEY=secret

# GetYourGuide adapter — HTTP Basic credentials GYG will call us with.
# Real values come from the Integrator Portal ("Set Up Your Testing Configuration").
GYG_USER=gyg
GYG_PASSWORD=gyg-secret

# GetYourGuide outbound — the pair shown under "GetYourGuide Credentials" in the
# Integrator Portal. We use it when WE call THEM (notify-availability-update,
# deals, suppliers). Not read by the server yet, kept here for the sandbox scripts.
GYG_OUTBOUND_USER=
GYG_OUTBOUND_PASSWORD=
